<Project>
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Version>1.3.1</Version>
    <Product>Capataz</Product>
    <Company>Pesalab</Company>
    <Copyright>Copyright (c) 2026 Pesalab</Copyright>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <!--
    Build de capturas para los manuales (solo a mano, via scripts/capturas-manual.ps1): define la constante
    CAPTURAS_MANUAL. Sin -p:CapturasManual=true (build normal, publicar.ps1, instalador) no cambia nada.
    CapturasRaiz separa bin y obj de ese build para no mezclarlos con los normales (una carpeta por proyecto,
    porque project.assets.json vive en obj y no se puede compartir entre proyectos).
  -->
  <PropertyGroup Condition="'$(CapturasManual)' == 'true'">
    <DefineConstants>$(DefineConstants);CAPTURAS_MANUAL</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(CapturasManual)' == 'true' and '$(CapturasRaiz)' != ''">
    <BaseIntermediateOutputPath>$(CapturasRaiz)/obj/$(MSBuildProjectName)/</BaseIntermediateOutputPath>
    <BaseOutputPath>$(CapturasRaiz)/bin/$(MSBuildProjectName)/</BaseOutputPath>
    <!-- Los obj y bin normales del proyecto quedan fuera de la compilacion (si no, sus AssemblyInfo se duplican). -->
    <DefaultItemExcludes>$(DefaultItemExcludes);obj/**;bin/**</DefaultItemExcludes>
  </PropertyGroup>
</Project>
